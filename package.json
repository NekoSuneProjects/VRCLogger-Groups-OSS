{
    "name": "banlogger",
    "version": "1.1.1",
    "description": "Logger",
    "main": "index.js",
    "bin": "index.js",
    "author": "NekoSuneVR",
    "scripts": {
        "test": "electron .",
        "build": "electron-builder",
        "build:win": "electron-builder --win"
    },
    "build": {
        "copyright": "Copyright © 2024-2026 NekoSuneVR",
        "appId": "com.nekosunevr.banlogger",
        "productName": "BanLogger",
        "nsis": {
            "allowToChangeInstallationDirectory": true,
            "license": "license.txt",
            "oneClick": false
        },
        "win": {
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "icon": "assets/icon.ico",
            "files": [
                "main.js",
                "web/**/*",
                "preload.js",
                "index.js",
                "APIClient/**",
                "assets/**",
                "AvatarUpload/**",
                "Configfiles/**",
                "functions/**",
                "models/**",
                "playercounter/**",
                "SafetyProtection/**",
                "Splitlogjsonpart/**",
                "VRChatLogUserID/**",
                "vrcx/**"
            ],
            "target": [
                "nsis",
                "msi"
            ]
        },
        "appx": {
            "backgroundColor": "#ffffff",
            "displayName": "BanLogger",
            "publisher": "CN=NekoSuneVR",
            "publisherDisplayName": "NekoSuneVR",
            "identityName": "com.nekosunevr.banlogger"
        },
        "directories": {
            "output": "dist",
            "buildResources": "assets"
        },
        "extraFiles": [
            {
                "from": "assets/alert.wav",
                "to": "assets/alert.wav"
            }
        ]
    },
    "license": "MIT",
    "dependencies": {
        "axios": "1.16.0",
        "bottleneck": "^2.19.5",
        "child_process": "^1.0.2",
        "chokidar": "^5.0.0",
        "clc": "^1.0.2",
        "cli-color": "^2.0.4",
        "configstore": "^8.0.0",
        "find-process": "^2.1.1",
        "fuzzyset": "^1.0.7",
        "music-metadata": "^11.12.3",
        "node-fetch": "3.3.2",
        "p-queue": "^9.2.0",
        "path": "^0.12.7",
        "pcm-volume": "^1.0.0",
        "play-sound": "^1.1.6",
        "readline": "^1.3.0",
        "say": "^0.16.0",
        "sequelize": "^6.37.8",
        "speaker": "^0.5.5",
        "sqlite3": "^6.0.1",
        "@nekosuneprojects/vrnotications": "^1.0.2"
    },
    "devDependencies": {
        "electron": "^44.3.0",
        "electron-builder": "^26.8.1"
    }
}
